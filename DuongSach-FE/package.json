{
  "name": "duongsach-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "npm --prefix ../DuongSach-BE run dev",
    "dev:server": "npm --prefix ../DuongSach-BE run dev",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "check:no-mock": "node scripts/check-no-fe-mock.mjs",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:desktop": "playwright test --project=desktop-chromium",
    "test:e2e:mobile": "playwright test --project=mobile-chromium",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "framer-motion": "^13.4.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.45.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
