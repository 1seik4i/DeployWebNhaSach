# The Vercel rewrite in vercel.json proxies /api to Render, so this may stay /api.
VITE_API_BASE_URL=/api
# Used when generating public QR links.
VITE_PUBLIC_SITE_URL=https://your-vercel-project.vercel.app

# Optional override for the backend WebSocket endpoint (direct connection, no SPA proxy).
VITE_WS_URL=
