# Để trống khi dùng Vite proxy cục bộ.
VITE_API_BASE_URL=/api

# URL website công khai được mã hóa trong QR. Để trống để dùng domain hiện tại.
# Khi in QR, đặt URL website thật có thể truy cập từ điện thoại.
VITE_PUBLIC_SITE_URL=

# Optional override for the backend WebSocket endpoint (direct connection, no SPA proxy).
VITE_WS_URL=
