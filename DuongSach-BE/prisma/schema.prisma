// H. Người tham gia (Participant)
// -------------------------------------------------------------

model PublicEventRegistration {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId String @map("event_id") @db.Uuid
  fullName String @map("full_name")
  email String
  phone String
  attendeesCount Int @default(1) @map("attendees_count")
  registrationCode String @unique @map("registration_code")
  notes String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  event Event @relation(fields: [eventId], references: [id])
  @@unique([eventId, email])
  @@map("public_event_registrations")
}

model EventRegistration {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String    @map("event_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  joinedAt    DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt      DateTime? @map("left_at") @db.Timestamptz(6)
  autoCreated Boolean   @default(false) @map("auto_created") // BR-12

  event                 Event                  @relation(fields: [eventId], references: [id])
  user                  User                   @relation(fields: [userId], references: [id])
  activityRegistrations ActivityRegistration[]
  boothVisits           BoothVisit[]

  @@unique([eventId, userId])
  @@map("event_registrations")
}

model ActivityRegistration {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activityId          String             @map("activity_id") @db.Uuid
  userId              String             @map("user_id") @db.Uuid
  eventRegistrationId String?            @map("event_registration_id") @db.Uuid
  status              RegistrationStatus @default(registered)
  registrationCode    String             @unique @map("registration_code") @db.VarChar(24)
  qrToken             String             @unique @default(dbgenerated("gen_random_uuid()")) @map("qr_token") @db.Uuid
  qrRevokedAt         DateTime?          @map("qr_revoked_at") @db.Timestamptz(6)
  registeredAt        DateTime           @default(now()) @map("registered_at") @db.Timestamptz(6)
  cancelledAt         DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  cancelReason        String?            @map("cancel_reason")
  isLate              Boolean            @default(false) @map("is_late")
  pointsAwarded       Boolean            @default(false) @map("points_awarded") // BR-52
  certificateIssued   Boolean            @default(false) @map("certificate_issued")

  activity           Activity            @relation(fields: [activityId], references: [id])
  user               User                @relation(fields: [userId], references: [id])
  eventRegistration  EventRegistration?  @relation(fields: [eventRegistrationId], references: [id])
  attendanceSessions AttendanceSession[]
  attendance         Attendance?
  rating             ActivityRating?
  pointTransactions  PointTransaction[]
  certificate        Certificate?

  @@map("activity_registrations")
}

// MVP Attendance: QR belongs to Activity, and one active ActivityRegistration
// creates at most one ATTENDED record. AttendanceSession remains legacy until API migration completes.
model Attendance {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  registrationId String   @unique @map("registration_id") @db.Uuid
  activityId     String   @map("activity_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  attendedAt     DateTime @default(now()) @map("attended_at") @db.Timestamptz(6)
  isOverride     Boolean  @default(false) @map("is_override")
  overriddenBy   String?  @map("overridden_by") @db.Uuid
  overrideReason String?  @map("override_reason")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  registration ActivityRegistration @relation(fields: [registrationId], references: [id])
  activity     Activity             @relation(fields: [activityId], references: [id])
  user         User                 @relation("AttendanceParticipant", fields: [userId], references: [id])
  overrider    User?                @relation("AttendanceOverriddenBy", fields: [overriddenBy], references: [id])
  certificate  Certificate?

  @@map("attendances")
}

// QR of an ACTIVE BoothAssignment creates one reward-eligible visit for each
// EventRegistration + BoothAssignment pair (BR-43, BR-44, BR-48).
model BoothVisit {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventRegistrationId String   @map("event_registration_id") @db.Uuid
  boothAssignmentId   String   @map("booth_assignment_id") @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  visitedAt           DateTime @default(now()) @map("visited_at") @db.Timestamptz(6)
  scanTokenHash       String?  @map("scan_token_hash")

  eventRegistration EventRegistration @relation(fields: [eventRegistrationId], references: [id])
  boothAssignment   BoothAssignment   @relation(fields: [boothAssignmentId], references: [id])
  user              User              @relation(fields: [userId], references: [id])
  pointTransaction  PointTransaction?

  @@unique([eventRegistrationId, boothAssignmentId])
  @@map("booth_visits")
}

model AttendanceSession {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  registrationId  String          @map("registration_id") @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  activityId      String          @map("activity_id") @db.Uuid
  checkInAt       DateTime        @default(now()) @map("check_in_at") @db.Timestamptz(6)
  checkOutAt      DateTime?       @map("check_out_at") @db.Timestamptz(6)
  durationMinutes Int?            @map("duration_minutes")
  state           AttendanceState @default(checked_in)
  scannedBy       String?         @map("scanned_by") @db.Uuid
  isOverride      Boolean         @default(false) @map("is_override")
  overrideBy      String?         @map("override_by") @db.Uuid
  overrideReason  String?         @map("override_reason")

  registration ActivityRegistration @relation(fields: [registrationId], references: [id])
  user         User                 @relation("ParticipantAttendance", fields: [userId], references: [id])
  activity     Activity             @relation(fields: [activityId], references: [id])
  scanner      User?                @relation("ScannerAttendance", fields: [scannedBy], references: [id])
  overrider    User?                @relation("OverrideAttendance", fields: [overrideBy], references: [id])

  @@map("attendance_sessions")
}

model ActivityRating {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activityId     String   @map("activity_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  registrationId String   @unique @map("registration_id") @db.Uuid
  rating         Int      @db.SmallInt
  comment        String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  activity     Activity             @relation(fields: [activityId], references: [id])
  user         User                 @relation(fields: [userId], references: [id])
  registration ActivityRegistration @relation(fields: [registrationId], references: [id])

  @@map("activity_ratings")
}

