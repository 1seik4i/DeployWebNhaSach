generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, citext, unaccent, pg_trgm, btree_gist]
}

enum UserRole {
  partner
  admin

  @@map("user_role")
}

enum AccountStatus {
  active
  locked
  pending_verification

  @@map("account_status")
}

enum EventStatus {
  draft
  published
  ongoing
  completed
  cancelled

  @@map("event_status")
}

enum EventPriority {
  high
  medium
  regular

  @@map("event_priority")
}

enum LocationKind {
  booth
  main_stage
  workshop_area
  reading_area
  other

  @@map("location_kind")
}

enum BoothOpStatus {
  operational
  unavailable

  @@map("booth_op_status")
}

enum BoothReqStatus {
  pending
  approved
  rejected
  withdrawn
  expired
  cancelled

  @@map("booth_req_status")
}

enum BoothReqKind {
  new
  change
  cancellation

  @@map("booth_req_kind")
}

enum AssignmentStatus {
  active
  released

  @@map("assignment_status")
}

enum PartnerAppStatus {
  draft
  submitted
  approved
  rejected
  need_changes
  withdrawn

  @@map("partner_app_status")
}

enum ProposalStatus {
  pending
  approved
  need_revision
  rejected
  withdrawn

  @@map("proposal_status")
}

enum ActivityStatus {
  draft
  approved
  published
  ongoing
  completed
  cancelled

  @@map("activity_status")
}

enum ActivityKind {
  talkshow
  workshop
  launch
  exhibition
  minigame
  signing

  @@map("activity_kind")
}

enum RegistrationStatus {
  registered
  cancelled
  attended
  no_show

  @@map("registration_status")
}

enum AttendanceState {
  checked_in
  checked_out
  invalidated

  @@map("attendance_state")
}

enum RequestStatus {
  pending
  approved
  rejected
  cancelled
  withdrawn

  @@map("request_status")
}

enum FeedbackStatus {
  new
  in_progress
  responded
  closed

  @@map("feedback_status")
}

enum FeedbackScope {
  entire
  heritage
  booth
  facility

  @@map("feedback_scope")
}

enum FeedbackSource {
  qr_general
  qr_heritage
  web_landing

  @@map("feedback_source")
}

enum HeritageStatus {
  published
  draft
  hidden

  @@map("heritage_status")
}

enum QrStatus {
  active
  generating
  inactive

  @@map("qr_status")
}

enum NotificationKind {
  event
  activity
  booth
  system
  reminder
  security
  account
  role

  @@map("notification_kind")
}

// -------------------------------------------------------------
// A. Identity & Access
// -------------------------------------------------------------

model User {
  bookSubmissions    BookSubmission[]     @relation("BookSubmittedBy")
  bookReviews        BookSubmission[]     @relation("BookReviewedBy")
  stallAssignment    UserStallAssignment?
  passwordChangedAt  DateTime?            @map("password_changed_at") @db.Timestamptz(6)
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code               String?              @unique @db.VarChar(20)
  fullName           String               @map("full_name") @db.VarChar(160)
  email              String               @unique @db.Citext
  phone              String?              @db.VarChar(20)
  passwordHash       String               @map("password_hash")
  primaryRole        UserRole             @default(partner) @map("primary_role")
  status             AccountStatus        @default(pending_verification)
  lockReason         String?              @map("lock_reason")
  avatarUrl          String?              @map("avatar_url")
  totalPoints        Int                  @default(0) @map("total_points")
  department         String?              @db.VarChar(200)
  emailNotifications Boolean              @default(true) @map("email_notifications")
  lastActiveAt       DateTime?            @map("last_active_at") @db.Timestamptz(6)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  isDeleted          Boolean              @default(false) @map("is_deleted")
  deletedAt          DateTime?            @map("deleted_at") @db.Timestamptz(6)
  deletedBy          String?              @map("deleted_by") @db.Uuid

  deleterUser  User?  @relation("UserDeletions", fields: [deletedBy], references: [id])
  deletedUsers User[] @relation("UserDeletions")

  userRoles                      UserRoleAssignment[]
  refreshTokens                  RefreshToken[]
  passwordResets                 PasswordReset[]
  orgMembers                     OrganizationMember[]
  createdEvents                  Event[]                       @relation("EventCreatedBy")
  reviewedPartnerApps            PartnerApplication[]          @relation("PartnerAppReviewedBy")
  requestedPartnerWithdrawals    PartnerWithdrawal[]           @relation("PartnerWithdrawalRequestedBy")
  reviewedPartnerWithdrawals     PartnerWithdrawal[]           @relation("PartnerWithdrawalReviewedBy")
  reviewedBoothReqs              BoothRequest[]                @relation("BoothReqReviewedBy")
  assignedBooths                 BoothAssignment[]             @relation("BoothAssignedBy")
  requestedBoothChanges          BoothChangeRequest[]          @relation("BoothChangeRequestedBy")
  reviewedBoothChanges           BoothChangeRequest[]          @relation("BoothChangeReviewedBy")
  requestedBoothCancellations    BoothCancellationRequest[]    @relation("BoothCancellationRequestedBy")
  reviewedBoothCancellations     BoothCancellationRequest[]    @relation("BoothCancellationReviewedBy")
  requestedActivityChanges       ActivityChangeRequest[]       @relation("ActivityChangeRequestedBy")
  reviewedActivityChanges        ActivityChangeRequest[]       @relation("ActivityChangeReviewedBy")
  requestedActivityCancellations ActivityCancellationRequest[] @relation("ActivityCancellationRequestedBy")
  reviewedActivityCancellations  ActivityCancellationRequest[] @relation("ActivityCancellationReviewedBy")
  activityReviews                ActivityReview[]              @relation("ActivityReviewBy")
  createdActivities              Activity[]                    @relation("ActivityCreatedBy")
  eventRegistrations             EventRegistration[]
  activityRegistrations          ActivityRegistration[]
  attendanceSessions             AttendanceSession[]           @relation("ParticipantAttendance")
  scannedAttendances             AttendanceSession[]           @relation("ScannerAttendance")
  overrideAttendances            AttendanceSession[]           @relation("OverrideAttendance")
  attendances                    Attendance[]                  @relation("AttendanceParticipant")
  overriddenAttendances          Attendance[]                  @relation("AttendanceOverriddenBy")
  boothVisits                    BoothVisit[]
  activityRatings                ActivityRating[]
  pointTransactions              PointTransaction[]
  userBadges                     UserBadge[]
  issuedCertificates             Certificate[]                 @relation("CertIssuedTo")
  assignedFeedbacks              Feedback[]                    @relation("FeedbackAssignedTo")
  notifications                  Notification[]
  auditLogs                      AuditLog[]                    @relation("AuditActor")

  @@map("users")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  rolePerms RolePermission[]
  userRoles UserRoleAssignment[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(80)
  name        String   @db.VarChar(120)
  module      String   @db.VarChar(50)
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePerms RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model PasswordReset {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

// -------------------------------------------------------------
// B. Tổ chức & Đối tác
// -------------------------------------------------------------

model Organization {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String   @db.VarChar(200)
  shortDesc          String?  @map("short_desc")
  logoUrl            String?  @map("logo_url")
  representativeName String   @map("representative_name") @db.VarChar(160)
  email              String   @db.Citext
  phone              String   @db.VarChar(20)
  address            String?
  website            String?
  categories         String[] @default([])
  isVerified         Boolean  @default(false) @map("is_verified")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  isDeleted          Boolean  @default(false) @map("is_deleted")

  members           OrganizationMember[]
  applications      PartnerApplication[]
  withdrawals       PartnerWithdrawal[]
  boothRequests     BoothRequest[]
  boothAssignments  BoothAssignment[]
  activityProposals ActivityProposal[]
  activities        Activity[]

  @@map("organizations")
}

model OrganizationMember {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  roleInOrg      String   @default("member") @map("role_in_org") @db.VarChar(50)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("organization_members")
}

// -------------------------------------------------------------
// C. Không gian vật lý
// -------------------------------------------------------------

model Venue {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @db.VarChar(160)
  facility  String    @db.VarChar(160)
  capacity  Int
  address   String?
  isActive  Boolean   @default(true) @map("is_active")
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  locations Location[]
  events    Event[]

  @@unique([name, facility])
  @@map("venues")
}

model Location {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venueId   String       @map("venue_id") @db.Uuid
  code      String       @db.VarChar(20)
  name      String       @db.VarChar(160)
  nameEn    String?      @map("name_en") @db.VarChar(160)
  kind      LocationKind
  capacity  Int          @default(0) // BR-32
  zone      String?      @db.VarChar(40)
  mapX      Decimal?     @map("map_x") @db.Decimal(6, 2)
  mapY      Decimal?     @map("map_y") @db.Decimal(6, 2)
  isDeleted Boolean      @default(false) @map("is_deleted")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  venue                 Venue                   @relation(fields: [venueId], references: [id], onDelete: Restrict)
  booth                 Booth?
  activities            Activity[]
  proposals             ActivityProposal[]
  activityChangeTargets ActivityChangeRequest[] @relation("ActivityChangeTargetLocation")
  eventLocations        EventLocation[]

  @@unique([venueId, code])
  @@map("locations")
}

model Booth {
  bookSales       BookSale[]
  content         Json                  @default("{}")
  libraryUsers    UserStallAssignment[]
  bookStalls      BookStall[]
  bookSubmissions BookSubmission[]
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locationId      String                @unique @map("location_id") @db.Uuid
  code            String                @unique @db.VarChar(20)
  name            String                @db.VarChar(160)
  nameEn          String?               @map("name_en") @db.VarChar(160)
  publisher       String?               @db.VarChar(160)
  category        String?               @db.VarChar(40)
  areaName        String?               @map("area_name") @db.VarChar(80)
  dimensions      String?               @db.VarChar(40)
  openHours       String?               @map("open_hours") @db.VarChar(60)
  description     String?
  descriptionEn   String?               @map("description_en")
  imageUrl        String?               @map("image_url")
  imageAlt        String?               @map("image_alt")
  imageSource     String?               @map("image_source")
  imageLicense    String?               @map("image_license")
  opStatus        BoothOpStatus         @default(operational) @map("op_status") // BR-19
  isDeleted       Boolean               @default(false) @map("is_deleted")
  deletedAt       DateTime?             @map("deleted_at") @db.Timestamptz(6)
  deletedBy       String?               @map("deleted_by") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  location      Location             @relation(fields: [locationId], references: [id], onDelete: Restrict)
  holds         BoothHold[]
  requests      BoothRequest[]
  assignments   BoothAssignment[]
  changeTargets BoothChangeRequest[] @relation("BoothChangeTarget")
  feedbacks     Feedback[]

  @@map("booths")
}

model MapHotspot {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(20)
  title       String   @db.VarChar(160)
  titleEn     String?  @map("title_en") @db.VarChar(160)
  category    String   @db.VarChar(40)
  x           Decimal  @db.Decimal(6, 2)
  y           Decimal  @db.Decimal(6, 2)
  shortDesc   String?  @map("short_desc")
  shortDescEn String?  @map("short_desc_en")
  boothId     String?  @map("booth_id") @db.Uuid
  iconType    String?  @map("icon_type") @db.VarChar(40)
  area        String?  @db.VarChar(80)
  dimensions  String?  @db.VarChar(40)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("map_hotspots")
}

model Asset {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String    @db.VarChar(120)
  totalQuantity Int       @default(0) @map("total_quantity")
  description   String?
  isDeleted     Boolean   @default(false) @map("is_deleted")
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy     String?   @map("deleted_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  proposalDevices ProposalDevice[]

  @@map("assets")
}

// -------------------------------------------------------------
// D. Sự kiện
// -------------------------------------------------------------

model Event {
  visibility    String        @default("public") @db.VarChar(20)
  publicUntil   DateTime?     @map("public_until") @db.Timestamptz(6)
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String        @db.VarChar(200)
  titleEn       String?       @map("title_en") @db.VarChar(200)
  slug          String        @unique @db.VarChar(200)
  theme         String?       @db.VarChar(200)
  venueId       String?       @map("venue_id") @db.Uuid
  startAt       DateTime      @map("start_at") @db.Timestamptz(6)
  endAt         DateTime      @map("end_at") @db.Timestamptz(6)
  status        EventStatus   @default(draft) // BR-06
  priorityLevel EventPriority @default(regular) @map("priority_level")
  description   String?
  summary       String?
  summaryEn     String?       @map("summary_en")
  coverImageUrl String?       @map("cover_image_url")
  publishedAt   DateTime?     @map("published_at") @db.Timestamptz(6)
  cancelledAt   DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  cancelReason  String?       @map("cancel_reason")
  createdBy     String?       @map("created_by") @db.Uuid
  isDeleted     Boolean       @default(false) @map("is_deleted")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  venue            Venue?               @relation(fields: [venueId], references: [id])
  creator          User?                @relation("EventCreatedBy", fields: [createdBy], references: [id])
  settings         EventSettings?
  eventLocations   EventLocation[]
  applications     PartnerApplication[]
  withdrawals      PartnerWithdrawal[]
  boothHolds       BoothHold[]
  boothRequests    BoothRequest[]
  boothAssignments BoothAssignment[]
  proposals        ActivityProposal[]
  activities       Activity[]
  registrations    EventRegistration[]
  publicRegistrations PublicEventRegistration[]
  feedbacks        Feedback[]

  @@map("events")
}

model EventSettings {
  eventId                 String    @id @map("event_id") @db.Uuid
  partnerApplyDeadline    DateTime? @map("partner_apply_deadline") @db.Timestamptz(6)
  boothRequestDeadline    DateTime? @map("booth_request_deadline") @db.Timestamptz(6)
  boothCancelCutoff       DateTime? @map("booth_cancel_cutoff") @db.Timestamptz(6)
  proposalDeadline        DateTime? @map("proposal_deadline") @db.Timestamptz(6)
  participantRegDeadline  DateTime? @map("participant_reg_deadline") @db.Timestamptz(6)
  activityCancelCutoff    DateTime? @map("activity_cancel_cutoff") @db.Timestamptz(6)
  maxBoothsPerPartner     Int       @default(1) @map("max_booths_per_partner")
  maxActivitiesPerPartner Int       @default(3) @map("max_activities_per_partner")
  boothHoldMinutes        Int       @default(60) @map("booth_hold_minutes")
  minAttendanceMinutes    Int       @default(20) @map("min_attendance_minutes") // BR-48
  pointsPerAttendance     Int       @default(10) @map("points_per_attendance")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_settings")
}

model EventLocation {
  eventId    String   @map("event_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([eventId, locationId])
  @@map("event_locations")
}

// -------------------------------------------------------------
// E. Đối tác tham gia Sự kiện
// -------------------------------------------------------------

model PartnerApplication {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId        String           @map("event_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  status         PartnerAppStatus @default(draft)
  step           Int              @default(1)
  submittedAt    DateTime?        @map("submitted_at") @db.Timestamptz(6)
  reviewedAt     DateTime?        @map("reviewed_at") @db.Timestamptz(6)
  reviewedBy     String?          @map("reviewed_by") @db.Uuid
  reviewNote     String?          @map("review_note")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  event              Event               @relation(fields: [eventId], references: [id])
  organization       Organization        @relation(fields: [organizationId], references: [id])
  reviewer           User?               @relation("PartnerAppReviewedBy", fields: [reviewedBy], references: [id])
  withdrawalRequests PartnerWithdrawal[]

  @@unique([eventId, organizationId])
  @@map("partner_applications")
}

model PartnerWithdrawal {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId        String        @map("event_id") @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  applicationId  String?       @map("application_id") @db.Uuid
  requestedBy    String?       @map("requested_by") @db.Uuid
  reviewedBy     String?       @map("reviewed_by") @db.Uuid
  reason         String
  status         RequestStatus @default(pending)
  reviewedAt     DateTime?     @map("reviewed_at") @db.Timestamptz(6)
  reviewNote     String?       @map("review_note")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  event        Event               @relation(fields: [eventId], references: [id])
  organization Organization        @relation(fields: [organizationId], references: [id])
  application  PartnerApplication? @relation(fields: [applicationId], references: [id])
  requester    User?               @relation("PartnerWithdrawalRequestedBy", fields: [requestedBy], references: [id])
  reviewer     User?               @relation("PartnerWithdrawalReviewedBy", fields: [reviewedBy], references: [id])

  @@map("partner_withdrawals")
}

// -------------------------------------------------------------
// F. Phân bổ Gian hàng
// -------------------------------------------------------------

model BoothHold {
  id         String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  boothId    String                    @map("booth_id") @db.Uuid
  eventId    String                    @map("event_id") @db.Uuid
  requestId  String?                   @map("request_id") @db.Uuid
  status     BoothReqStatus            @default(pending)
  period     Unsupported("tstzrange")?
  expiresAt  DateTime                  @map("expires_at") @db.Timestamptz(6)
  releasedAt DateTime?                 @map("released_at") @db.Timestamptz(6)
  createdAt  DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)

  booth            Booth               @relation(fields: [boothId], references: [id])
  event            Event               @relation(fields: [eventId], references: [id])
  requests         BoothRequest[]
  changeRequest    BoothChangeRequest? @relation("BoothChangeReplacementHold")
  sourceAssignment BoothAssignment?    @relation("AssignmentSourceHold")

  @@map("booth_holds")
}

model BoothRequest {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId              String         @map("event_id") @db.Uuid
  organizationId       String         @map("organization_id") @db.Uuid
  boothId              String         @map("booth_id") @db.Uuid
  kind                 BoothReqKind   @default(new)
  replacesAssignmentId String?        @map("replaces_assignment_id") @db.Uuid
  status               BoothReqStatus @default(pending)
  holdId               String?        @map("hold_id") @db.Uuid
  note                 String?
  isLate               Boolean        @default(false) @map("is_late") // BR-24
  submittedAt          DateTime       @default(now()) @map("submitted_at") @db.Timestamptz(6)
  reviewedAt           DateTime?      @map("reviewed_at") @db.Timestamptz(6)
  reviewedBy           String?        @map("reviewed_by") @db.Uuid
  reviewNote           String?        @map("review_note")
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  event        Event        @relation(fields: [eventId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  booth        Booth        @relation(fields: [boothId], references: [id])
  hold         BoothHold?   @relation(fields: [holdId], references: [id])
  reviewer     User?        @relation("BoothReqReviewedBy", fields: [reviewedBy], references: [id])

  @@map("booth_requests")
}

model BoothAssignment {
  id             String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  boothId        String                    @map("booth_id") @db.Uuid
  eventId        String                    @map("event_id") @db.Uuid
  organizationId String                    @map("organization_id") @db.Uuid
  status         AssignmentStatus          @default(active)
  assignedAt     DateTime                  @default(now()) @map("assigned_at") @db.Timestamptz(6)
  assignedBy     String?                   @map("assigned_by") @db.Uuid
  releasedAt     DateTime?                 @map("released_at") @db.Timestamptz(6)
  releaseReason  String?                   @map("release_reason")
  sourceHoldId   String?                   @unique @map("source_hold_id") @db.Uuid
  qrToken        String?                   @unique @default(dbgenerated("gen_random_uuid()")) @map("qr_token") @db.Uuid
  qrRevokedAt    DateTime?                 @map("qr_revoked_at") @db.Timestamptz(6)
  period         Unsupported("tstzrange")?

  booth                Booth                      @relation(fields: [boothId], references: [id])
  event                Event                      @relation(fields: [eventId], references: [id])
  organization         Organization               @relation(fields: [organizationId], references: [id])
  assigner             User?                      @relation("BoothAssignedBy", fields: [assignedBy], references: [id])
  sourceHold           BoothHold?                 @relation("AssignmentSourceHold", fields: [sourceHoldId], references: [id])
