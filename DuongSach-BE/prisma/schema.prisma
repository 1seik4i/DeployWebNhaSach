model ActivityProposal {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId             String         @map("event_id") @db.Uuid
  organizationId      String         @map("organization_id") @db.Uuid
  title               String         @db.VarChar(200)
  titleEn             String?        @map("title_en") @db.VarChar(200)
  kind                ActivityKind
  locationId          String         @map("location_id") @db.Uuid
  startAt             DateTime       @map("start_at") @db.Timestamptz(6)
  endAt               DateTime       @map("end_at") @db.Timestamptz(6)
  capacity            Int
  priorityLevel       EventPriority  @default(regular) @map("priority_level")
  targetAudience      String?        @map("target_audience")
  description         String?
  speaker             String?        @db.VarChar(160)
  contactPerson       String?        @map("contact_person") @db.VarChar(160)
  contactPhone        String?        @map("contact_phone") @db.VarChar(20)
  status              ProposalStatus @default(pending)
  managementNotes     String?        @map("management_notes")
  publishedActivityId String?        @map("published_activity_id") @db.Uuid
  submittedAt         DateTime       @default(now()) @map("submitted_at") @db.Timestamptz(6)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  event        Event            @relation(fields: [eventId], references: [id])
  organization Organization     @relation(fields: [organizationId], references: [id])
  location     Location         @relation(fields: [locationId], references: [id])
  devices      ProposalDevice[]
  reviews      ActivityReview[]
  activities   Activity[]

  @@map("activity_proposals")
}

model ProposalDevice {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  proposalId String  @map("proposal_id") @db.Uuid
  assetId    String? @map("asset_id") @db.Uuid
  name       String  @db.VarChar(120)
  quantity   Int

  proposal ActivityProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  asset    Asset?           @relation(fields: [assetId], references: [id])

  @@map("proposal_devices")
}

model Activity {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId         String         @map("event_id") @db.Uuid
  proposalId      String?        @map("proposal_id") @db.Uuid
  organizationId  String?        @map("organization_id") @db.Uuid
  title           String         @db.VarChar(200)
  titleEn         String?        @map("title_en") @db.VarChar(200)
  kind            ActivityKind
  locationId      String         @map("location_id") @db.Uuid
  startAt         DateTime       @map("start_at") @db.Timestamptz(6)
  endAt           DateTime       @map("end_at") @db.Timestamptz(6)
  capacity        Int
  registeredCount Int            @default(0) @map("registered_count")
  status          ActivityStatus @default(approved)
  hasCertificate  Boolean        @default(false) @map("has_certificate") // BR-51
  publishedAt     DateTime?      @map("published_at") @db.Timestamptz(6)
  cancelledAt     DateTime?      @map("cancelled_at") @db.Timestamptz(6)
  cancelReason    String?        @map("cancel_reason")
  description     String?
  speaker         String?        @db.VarChar(160)
  imageUrl        String?        @map("image_url")
  qrToken         String?        @unique @default(dbgenerated("gen_random_uuid()")) @map("qr_token") @db.Uuid
  qrRevokedAt     DateTime?      @map("qr_revoked_at") @db.Timestamptz(6)
  createdBy       String?        @map("created_by") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  event                Event                         @relation(fields: [eventId], references: [id])
  proposal             ActivityProposal?             @relation(fields: [proposalId], references: [id])
  organization         Organization?                 @relation(fields: [organizationId], references: [id])
  location             Location                      @relation(fields: [locationId], references: [id])
  creator              User?                         @relation("ActivityCreatedBy", fields: [createdBy], references: [id])
  registrations        ActivityRegistration[]
  attendanceSessions   AttendanceSession[]
  attendances          Attendance[]
  ratings              ActivityRating[]
  changeRequests       ActivityChangeRequest[]
  cancellationRequests ActivityCancellationRequest[]

  @@map("activities")
}

model ActivityChangeRequest {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
