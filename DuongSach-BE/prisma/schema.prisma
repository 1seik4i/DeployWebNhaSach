  @@map("heritages")
}

model HeritageQrCode {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  heritageId String   @map("heritage_id") @db.Uuid
  qrData     String   @map("qr_data")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  heritage Heritage @relation(fields: [heritageId], references: [id], onDelete: Cascade)

  @@map("heritage_qr_codes")
}

model Feedback {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  targetScope  FeedbackScope  @default(entire) @map("target_scope")
  heritageId   String?        @map("heritage_id") @db.Uuid
  boothId      String?        @map("booth_id") @db.Uuid
  eventId      String?        @map("event_id") @db.Uuid
  targetName   String?        @map("target_name") @db.VarChar(200)
  fullName     String?        @map("full_name") @db.VarChar(160)
  rating       Int            @db.SmallInt
  comments     String?
  contactEmail String?        @map("contact_email") @db.Citext
  source       FeedbackSource @default(web_landing)
  status       FeedbackStatus @default(new)
  assignedTo   String?        @map("assigned_to") @db.Uuid
  internalNote String?        @map("internal_note")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  heritage Heritage? @relation(fields: [heritageId], references: [id])
  booth    Booth?    @relation(fields: [boothId], references: [id])
  event    Event?    @relation(fields: [eventId], references: [id])
  assignee User?     @relation("FeedbackAssignedTo", fields: [assignedTo], references: [id])

  @@map("feedbacks")
}

// -------------------------------------------------------------
// K. Hệ thống (System)
// -------------------------------------------------------------

model Notification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  title     String           @db.VarChar(200)
  message   String
  kind      NotificationKind @default(system)
  isRead    Boolean          @default(false) @map("is_read")
  link      String?
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model AuditLog {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId     String?   @map("actor_id") @db.Uuid
  actorRole   UserRole? @map("actor_role")
  action      String    @db.VarChar(60)
  targetType  String    @map("target_type") @db.VarChar(60)
  targetId    String?   @map("target_id") @db.Uuid
  targetTitle String?   @map("target_title")
  beforeData  Json?     @map("before_data")
  afterData   Json?     @map("after_data")
  reason      String?
  ipAddress   String?   @map("ip_address")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  @@map("audit_logs")
}

model Setting {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique @db.VarChar(80)
  value       Json
  description String?
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("settings")
}

model UserStallAssignment {
  userId  String @id @map("user_id") @db.Uuid
  stallId String @unique @map("stall_id") @db.Uuid
  version Int    @default(1)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  stall   Booth  @relation(fields: [stallId], references: [id])

  @@map("user_stall_assignments")
}

model BookCategory {
  id     String  @id @default(uuid()) @db.Uuid
  name   String  @unique @db.VarChar(200)
  nameEn String? @map("name_en")
  status String  @default("active")
  books  Book[]

  @@map("book_categories")
}

model BookLabel {
  id     String                @id @default(uuid()) @db.Uuid
  name   String                @unique @db.VarChar(200)
  status String                @default("active")
  books  BookLabelAssignment[]

  @@map("book_labels")
}

model Book {
  id              String                @id @default(uuid()) @db.Uuid
  isbn            String                @unique @db.VarChar(32)
  title           String                @db.VarChar(200)
  titleEn         String?               @map("title_en")
  author          String                @db.VarChar(200)
  publisher       String?
  coverUrl        String                @map("cover_url")
  description     String?
  publicationYear Int?                  @map("publication_year")
  categoryId      String?               @map("category_id") @db.Uuid
  status          String                @default("active")
  version         Int                   @default(1)
  updatedAt       DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  category        BookCategory?         @relation(fields: [categoryId], references: [id])
  labels          BookLabelAssignment[]
  stalls          BookStall[]
  submissions     BookSubmission[]
  sales           BookSale[]
  rankings        BookRanking[]

  @@map("books")
}

model BookRanking {
  id          String   @id @default(uuid()) @db.Uuid
  bookId      String   @map("book_id") @db.Uuid
  rankingType String   @map("ranking_type") @db.VarChar(32)
  rank        Int
  updatedBy   String?  @map("updated_by") @db.Uuid
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  book        Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([rankingType, rank])
  @@unique([rankingType, bookId])
  @@index([rankingType, rank])
  @@map("book_rankings")
}

model BookLabelAssignment {
  bookId  String    @map("book_id") @db.Uuid
  labelId String    @map("label_id") @db.Uuid
  book    Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  label   BookLabel @relation(fields: [labelId], references: [id])

  @@id([bookId, labelId])
  @@map("book_label_assignments")
}

model BookStall {
  id                String   @id @default(uuid()) @db.Uuid
  bookId            String   @map("book_id") @db.Uuid
  stallId           String   @map("stall_id") @db.Uuid
  inventoryQuantity Int      @default(0) @map("inventory_quantity")
  soldQuantity      Int?     @map("sold_quantity")
  version           Int      @default(1)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  book              Book     @relation(fields: [bookId], references: [id])
  stall             Booth    @relation(fields: [stallId], references: [id])

  @@unique([bookId, stallId])
  @@map("book_stalls")
}

model BookSubmission {
  submitter           User      @relation("BookSubmittedBy", fields: [submittedBy], references: [id])
  reviewer            User?     @relation("BookReviewedBy", fields: [reviewedBy], references: [id])
  id                  String    @id @default(uuid()) @db.Uuid
  bookId              String?   @map("book_id") @db.Uuid
  stallId             String    @map("stall_id") @db.Uuid
  type                String
  status              String    @default("PENDING")
  submittedBy         String    @map("submitted_by") @db.Uuid
  submittedAt         DateTime  @default(now()) @map("submitted_at") @db.Timestamptz(6)
  reviewedBy          String?   @map("reviewed_by") @db.Uuid
  reviewedAt          DateTime? @map("reviewed_at") @db.Timestamptz(6)
  rejectionReason     String?   @map("rejection_reason")
  proposedData        Json      @map("proposed_data")
  currentApprovedData Json?     @map("current_approved_data")
  bookVersion         Int?      @map("book_version")
  inventoryQuantity   Int       @default(0) @map("inventory_quantity")
  soldQuantity        Int?      @map("sold_quantity")
  book                Book?     @relation(fields: [bookId], references: [id])
  stall               Booth     @relation(fields: [stallId], references: [id])

  @@index([stallId, status])
  @@map("book_submissions")
}

model BookSale {
  booth     Booth    @relation(fields: [boothId], references: [id])
  id        String   @id @default(uuid()) @db.Uuid
  bookId    String   @map("book_id") @db.Uuid
  boothId   String   @map("booth_id") @db.Uuid
  quantity  Int
  soldDate  DateTime @map("sold_date") @db.Date
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  book      Book     @relation(fields: [bookId], references: [id])

  @@index([boothId, soldDate])
  @@map("book_sales")
}

model ContentEntry {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  kind      String
  title     String
  data      Json
  status    String   @default("draft")
  version   Int      @default(1)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  articleReads NewsArticleRead[]

  @@map("content_entries")
}

model NewsArticleRead {
  id             String   @id @default(uuid()) @db.Uuid
  contentEntryId String   @map("content_entry_id") @db.Uuid
  articleId      String   @map("article_id") @db.VarChar(200)
  sessionId      String   @map("session_id") @db.Uuid
  day            DateTime @db.Date
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  contentEntry   ContentEntry @relation(fields: [contentEntryId], references: [id], onDelete: Cascade)

  @@unique([contentEntryId, articleId, sessionId, day])
  @@index([contentEntryId, articleId])
  @@index([day])
  @@map("news_article_reads")
}

model EventSuggestion {
  id           String   @id @default(uuid()) @db.Uuid
  fullName     String   @map("full_name")
  phone        String
  content      String
  status       String   @default("new")
  internalNote String?  @map("internal_note")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("event_suggestions")
}

model SiteVisit {
  id         String   @id @default(uuid()) @db.Uuid
  sessionId  String   @map("session_id") @db.Uuid
  day        DateTime @db.Date
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  @@unique([sessionId, day])
  @@index([day])
  @@index([lastSeenAt])
  @@map("site_visits")
}
