  @@map("booth_assignments")
}

// Change/cancellation are separate aggregates.  A legacy BoothRequest.kind is
// retained temporarily for backward compatibility, but new workflows use these tables.
model BoothChangeRequest {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  currentAssignmentId String         @map("current_assignment_id") @db.Uuid
  targetBoothId       String         @map("target_booth_id") @db.Uuid
  replacementHoldId   String?        @unique @map("replacement_hold_id") @db.Uuid
  resultAssignmentId  String?        @unique @map("result_assignment_id") @db.Uuid
  requestedBy         String         @map("requested_by") @db.Uuid
  reviewedBy          String?        @map("reviewed_by") @db.Uuid
  reason              String
  status              BoothReqStatus @default(pending)
  submittedAt         DateTime       @default(now()) @map("submitted_at") @db.Timestamptz(6)
  reviewedAt          DateTime?      @map("reviewed_at") @db.Timestamptz(6)
  reviewNote          String?        @map("review_note")
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  currentAssignment BoothAssignment  @relation("BoothChangeCurrentAssignment", fields: [currentAssignmentId], references: [id])
  targetBooth       Booth            @relation("BoothChangeTarget", fields: [targetBoothId], references: [id])
  replacementHold   BoothHold?       @relation("BoothChangeReplacementHold", fields: [replacementHoldId], references: [id])
  resultAssignment  BoothAssignment? @relation("BoothChangeResultAssignment", fields: [resultAssignmentId], references: [id])
  requester         User             @relation("BoothChangeRequestedBy", fields: [requestedBy], references: [id])
  reviewer          User?            @relation("BoothChangeReviewedBy", fields: [reviewedBy], references: [id])

  @@map("booth_change_requests")
}

model BoothCancellationRequest {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignmentId String        @map("assignment_id") @db.Uuid
  requestedBy  String        @map("requested_by") @db.Uuid
  reviewedBy   String?       @map("reviewed_by") @db.Uuid
  reason       String
  isLate       Boolean       @default(false) @map("is_late")
  status       RequestStatus @default(pending)
  submittedAt  DateTime      @default(now()) @map("submitted_at") @db.Timestamptz(6)
  reviewedAt   DateTime?     @map("reviewed_at") @db.Timestamptz(6)
  reviewNote   String?       @map("review_note")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  assignment BoothAssignment @relation(fields: [assignmentId], references: [id])
  requester  User            @relation("BoothCancellationRequestedBy", fields: [requestedBy], references: [id])
  reviewer   User?           @relation("BoothCancellationReviewedBy", fields: [reviewedBy], references: [id])

  @@map("booth_cancellation_requests")
}

