# Render supplies DATABASE_URL from the managed PostgreSQL database in render.yaml.
NODE_ENV=production
JWT_ACCESS_SECRET=<set-by-render-or-a-long-random-secret>
JWT_REFRESH_SECRET=<set-by-render-or-a-long-random-secret>
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
# Replace with the final Vercel production URL. Add preview URLs too if required.
CORS_ORIGINS=https://your-vercel-project.vercel.app
PUBLIC_SITE_URL=https://your-vercel-project.vercel.app
PUBLIC_WEB_URL=https://your-vercel-project.vercel.app
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
LOG_LEVEL=info
TZ=Asia/Ho_Chi_Minh
