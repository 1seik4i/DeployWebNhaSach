{
  "name": "duongsach-backend",
  "version": "1.0.0",
  "description": "Backend API server for Book Street Event Management System",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-dev.js",
    "start": "node scripts/renderStart.js",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "generate": "prisma generate",
    "db:api-constraints": "node scripts/applyApiCompletion.js",
    "render:bootstrap": "node scripts/renderBootstrap.js",
    "seed": "node prisma/seed.js",
    "seed:export": "node scripts/exportDatabaseSnapshot.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcrypt": "^5.1.1",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.1.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.4.1",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.22.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vitest": "^3.0.8"
  }
}
